.DS_Store
._*
node_modules/

# Scrape output -- a point-in-time local artifact the Action regenerates on
# its own schedule and pushes to Firebase; nothing in the app reads this file
# directly, so committing it would just go stale in git.
data/standings-cache.json
data/pitchsmart-cache.json
data/team-details-cache.json
data/dashboard-roster-import.json
data/gamechanger-schedule-cache.json

# Real kids' names, even reduced to first name + last initial, don't belong
# in this (public) repo's git history. js/roster.js no longer reads this
# file at all -- it's listed here only so a locally-regenerated copy for
# testing is never accidentally staged.
data/roster-seed.json

# scripts/sync-contacts-from-dashboard.mjs's own staging file -- parent
# emails, pulled from lybs-reporting's Contacts carve-out (see that repo's
# CLAUDE.md). For a human to review before the same script merges it into
# a team's live roster in Firebase; never read by the app itself.
data/dashboard-contacts-import.json
