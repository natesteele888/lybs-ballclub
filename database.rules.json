{
  "rules": {
    ".read": false,
    ".write": false,

    "teams": {
      "$teamId": {
        ".read": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists() || root.child('boardMembers').child(auth.uid).val() == true)",

        "config": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "schedule": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists())" },
        "practices": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists())" },
        "roster": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "playerBenchmarks": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "gameChangerSnippet": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "gcTeamId": { ".write": "auth != null && root.child('boardMembers').child(auth.uid).val() == true" },
        "announcements": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "depthChart": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "lineups": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "dutyRotation": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "importedStats": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "drills": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "signups": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists())" },
        "awards": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "signalSets": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "equipment": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists())" },
        "pitcherDepth": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "practicePlans": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "playDiagrams": { ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')" },
        "songRequests": {
          "$rid": {
            ".write": "auth != null && ((auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach') || (!data.exists() && newData.child('st').val() == 'pending' && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists())))",
            ".validate": "newData.hasChildren(['pid', 'kind', 'title', 'st', 'at', 'start'])",
            "pid": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "kind": {
              ".validate": "newData.val() == 'library' || newData.val() == 'link' || newData.val() == 'upload'"
            },
            "lib": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "link": {
              ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https?:\\/\\//)"
            },
            "file": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "start": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
            },
            "st": {
              ".validate": "newData.val() == 'pending' || newData.val() == 'approved' || newData.val() == 'declined'"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "at": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "decidedAt": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "walkupSongs": {
          ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')"
        }
      }
    },

    "shared": {
      "rules": { ".read": "auth != null", ".write": "auth != null && root.child('boardMembers').child(auth.uid).val() == true" },
      "seasonArchive": { ".read": "auth != null", ".write": "auth != null && root.child('boardMembers').child(auth.uid).val() == true" },
      "macLeagueStandings": { ".read": "auth != null", ".write": false },
      "pitchSmart": {
        ".read": "auth != null",
        ".write": false,
        "$team": {
          "depthOrder": { ".write": "auth != null && ((auth.token.email != null && auth.token.email.matches(/^coach-[^@]+-gate@lybsballclub\\.internal$/)) || root.child('boardMembers').child(auth.uid).val() == true || (newData.parent().child('depthOrderBy').isString() && root.child('access').child(newData.parent().child('depthOrderBy').val()).child(auth.uid).val() == 'coach'))" },
          "depthOrderBy": { ".write": "auth != null && ((auth.token.email != null && auth.token.email.matches(/^coach-[^@]+-gate@lybsballclub\\.internal$/)) || root.child('boardMembers').child(auth.uid).val() == true || (newData.parent().child('depthOrderBy').isString() && root.child('access').child(newData.parent().child('depthOrderBy').val()).child(auth.uid).val() == 'coach'))", ".validate": "newData.isString()" }
        }
      },
      "macLeagueTeamDetails": { ".read": "auth != null", ".write": false },
      "practiceCatalog": { ".read": "auth != null", ".write": "auth != null && root.child('boardMembers').child(auth.uid).val() == true" },
      "skillBenchmarks": { ".read": "auth != null", ".write": "auth != null && root.child('boardMembers').child(auth.uid).val() == true" },
      "situationRules": { ".read": "auth != null", ".write": "auth != null && root.child('boardMembers').child(auth.uid).val() == true" }
    },

    "coachPrivate": {
      "$teamId": {
        ".read": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')",
        ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')"
      }
    },

    "access": {
      "$teamId": {
        ".read": "auth != null && (root.child('boardMembers').child(auth.uid).val() == true || root.child('access').child($teamId).child(auth.uid).val() == 'coach' || auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal'))",
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('boardMembers').child(auth.uid).val() == true || root.child('access').child($teamId).child(auth.uid).val() == 'coach' || auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal'))",
          ".write": "auth != null && ((auth.uid == $uid && auth.token.email_verified == true && root.child('invites').child(auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child($teamId).child('role').val() == newData.val()) || (!newData.exists() && (root.child('boardMembers').child(auth.uid).val() == true || (data.val() == 'parent' && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')))))",
          ".validate": "newData.isString() && (newData.val() == 'coach' || newData.val() == 'parent')"
        }
      }
    },

    "boardMembers": {
      ".read": "auth != null && root.child('boardMembers').child(auth.uid).val() == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('boardMembers').child(auth.uid).val() == true)",
        ".write": "auth != null && ((auth.uid == $uid && auth.token.email_verified == true && root.child('invites').child(auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child('board').child('role').val() == 'board') || (!newData.exists() && root.child('boardMembers').child(auth.uid).val() == true))",
        ".validate": "newData.isBoolean()"
      }
    },

    "people": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "invites": {
      "$emailKey": {
        "$teamIdOrBoard": {
          ".read": "auth != null && (root.child('boardMembers').child(auth.uid).val() == true || (auth.token.email_verified == true && $emailKey == auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')) || auth.token.email == ('coach-' + $teamIdOrBoard + '-gate@lybsballclub.internal') || root.child('access').child($teamIdOrBoard).child(auth.uid).val() == 'coach')",
          ".write": "auth != null && ((newData.exists() && root.child('boardMembers').child(auth.uid).val() == true) || (newData.exists() && newData.child('role').val() == 'parent' && (auth.token.email == ('coach-' + $teamIdOrBoard + '-gate@lybsballclub.internal') || root.child('access').child($teamIdOrBoard).child(auth.uid).val() == 'coach')) || (!newData.exists() && (root.child('boardMembers').child(auth.uid).val() == true || (auth.token.email_verified == true && $emailKey == auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')) || (data.child('role').val() == 'parent' && (auth.token.email == ('coach-' + $teamIdOrBoard + '-gate@lybsballclub.internal') || root.child('access').child($teamIdOrBoard).child(auth.uid).val() == 'coach')))))"
        }
      }
    },

    "invitesByTeam": {
      "$teamIdOrBoard": {
        ".read": "auth != null && (root.child('boardMembers').child(auth.uid).val() == true || auth.token.email == ('coach-' + $teamIdOrBoard + '-gate@lybsballclub.internal') || root.child('access').child($teamIdOrBoard).child(auth.uid).val() == 'coach')",
        "$emailKey": {
          ".write": "auth != null && ((newData.exists() && root.child('boardMembers').child(auth.uid).val() == true) || (newData.exists() && newData.child('role').val() == 'parent' && (auth.token.email == ('coach-' + $teamIdOrBoard + '-gate@lybsballclub.internal') || root.child('access').child($teamIdOrBoard).child(auth.uid).val() == 'coach')) || (!newData.exists() && (root.child('boardMembers').child(auth.uid).val() == true || (auth.token.email_verified == true && $emailKey == auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')) || (data.child('role').val() == 'parent' && (auth.token.email == ('coach-' + $teamIdOrBoard + '-gate@lybsballclub.internal') || root.child('access').child($teamIdOrBoard).child(auth.uid).val() == 'coach')))))"
        }
      }
    },

    "publicSchedule": {
      "$teamId": {
        "games": {
          ".read": true,
          ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists())"
        },
        "practices": {
          ".read": true,
          ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists())"
        }
      }
    },

    "leagueEvents": {
      ".read": true,
      ".write": "auth != null && root.child('boardMembers').child(auth.uid).val() == true"
    },

    "songFiles": {
      "$teamId": {
        ".read": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists() || root.child('boardMembers').child(auth.uid).val() == true)",
        "$fid": {
          ".write": "auth != null && ((auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach') || (!data.exists() && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists())))",
          ".validate": "newData.hasChildren(['type', 'size', 'data'])",
          "type": {
            ".validate": "newData.isString() && newData.val().matches(/^audio\\/[A-Za-z0-9.+-]{1,40}$/)"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "size": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 7340032"
          },
          "data": {
            ".validate": "newData.isString() && newData.val().length <= 9800000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "walkupLibrary": {
      ".read": "auth != null && auth.provider != 'anonymous'",
      "$id": {
        ".write": "auth != null && root.child('boardMembers').child(auth.uid).val() == true",
        ".validate": "newData.hasChildren(['title', 'at'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "size": {
          ".validate": "newData.isNumber()"
        },
        "at": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "walkupLibraryFiles": {
      ".read": "auth != null && auth.provider != 'anonymous'",
      "$id": {
        ".write": "auth != null && root.child('boardMembers').child(auth.uid).val() == true",
        ".validate": "newData.hasChildren(['type', 'size', 'data'])",
        "type": {
          ".validate": "newData.isString() && newData.val().matches(/^audio\\/[A-Za-z0-9.+-]{1,40}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "size": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 7340032"
        },
        "data": {
          ".validate": "newData.isString() && newData.val().length <= 9800000"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "pushSubs": {
      "$teamId": {
        "coach": {
          "$key": {
            ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).val() == 'coach')",
            ".validate": "!newData.exists() || newData.hasChildren(['sub', 'at'])"
          }
        },
        "req": {
          "$rid": {
            "$key": {
              ".write": "auth != null && (auth.token.email == ('coach-' + $teamId + '-gate@lybsballclub.internal') || auth.token.email == ('player-' + $teamId + '-gate@lybsballclub.internal') || root.child('access').child($teamId).child(auth.uid).exists())",
              ".validate": "!newData.exists() || newData.hasChildren(['sub', 'at'])"
            }
          }
        }
      }
    }
  }
}
